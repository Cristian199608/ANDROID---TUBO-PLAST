<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:paddingStart="30dp"
    android:paddingTop="5dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:background="@drawable/bg_gradient_promo"
        android:id="@+id/layoutPromo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="7dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPromocionTitulo"
            android:paddingTop="5dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layoutPromo"
            android:text="1) Tipo de promocion"
            android:textColor="@color/orange_700"
            android:textStyle="bold"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_promociones"
                android:paddingTop="5dp"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Promociones"
                android:textColor="#343434"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_verDetalle"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:layout_marginStart="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_rounded_corners6"
                    android:backgroundTint="@color/blue_100"
                    android:textColor="@color/black"
                    android:text=" Detalle"
                    android:drawableStart="@drawable/ic_eye_grey"
                    android:drawableTint="@color/blue_500"
                    android:gravity="center|start"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSalidaBonificacion"
                    android:layout_marginTop="5dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:layout_marginStart="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_rounded_corners5"
                    android:backgroundTint="@color/orange_500"
                    android:textColor="@color/black"
                    android:drawableStart="@drawable/ic_eye_grey"
                    android:drawableTint="@color/blue_500"
                    android:text="Salida Combo | Colores"
                    android:gravity="center|start"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_clienteLimitado"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_eye_grey"
                android:drawableTint="@color/white"
                android:background="@drawable/edittext_rounded_corners5"
                android:backgroundTint="@color/colorPrimary"
                android:text=" Restringido por Clientes"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_politicaLimitado"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                android:layout_marginStart="5dp"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_eye_grey"
                android:drawableTint="@color/white"
                android:background="@drawable/edittext_rounded_corners5"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"
                android:text="Restringido por Politicas"
                android:gravity="center"
                android:textSize="13sp" />

        </LinearLayout>


    </LinearLayout>

</RelativeLayout>
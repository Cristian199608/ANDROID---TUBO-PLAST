<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:minHeight="200dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:background="@color/blue_700"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:gravity="center|left"
                android:textSize="20dp"
                android:padding="10dp"
                android:text="Titulo"/>
            <EditText
                android:id="@+id/etBuscarOpcion"
                android:padding="5dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:hint="buscar..."
                android:background="@color/blue_400"
                android:backgroundTint="@color/blue_400"
                android:textColorHint="@color/blue_100"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:drawableTint="@color/white"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:paddingHorizontal="10dp"
            tools:listitem="@layout/list_item_multiselect_spinner"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            >

        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lauoutFooter"
        android:layout_alignParentBottom="true"
        android:paddingTop="5dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:gravity="center"

        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_cancelar"
            android:padding="5dp"
            android:backgroundTint="@color/red_500"
            android:drawableStart="@android:drawable/ic_delete"
            android:background="@drawable/edittext_rounded_corners_cicle"
            android:foreground="?android:attr/selectableItemBackground"
            app:drawableTint="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="Cancel"/>
        <TextView
            android:id="@+id/txt_quitar"
            android:padding="5dp"
            android:backgroundTint="@color/blue_grey_800"
            android:drawableStart="@android:drawable/ic_delete"
            android:background="@drawable/edittext_rounded_corners_cicle"
            android:foreground="?android:attr/selectableItemBackground"
            app:drawableTint="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="Borrar"/>

        <TextView
            android:id="@+id/txtSeleccTodos"
            android:padding="9dp"
            android:backgroundTint="@color/blue_grey_800"
            android:drawableStart="@drawable/ic_check"
            android:background="@drawable/edittext_rounded_corners_cicle"
            android:foreground="?android:attr/selectableItemBackground"
            app:drawableTint="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="Todos"/>

        <TextView
            android:id="@+id/txt_aceptar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/edittext_rounded_corners_cicle"
            android:backgroundTint="@color/blue_500"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:drawableStart="@drawable/ic_check"
            app:drawableTint="@color/white"
            android:text="Acept"
            android:gravity="center"
            android:textColor="@color/white"/>
    </LinearLayout>
</RelativeLayout>
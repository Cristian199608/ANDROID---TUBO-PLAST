<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:minHeight="200dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/fotterBtns"
        android:orientation="vertical">
        <LinearLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center|left"
                android:textSize="20dp"
                android:layout_marginHorizontal="10dp"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="0dp"
                android:text="Titulo"/>
            <EditText
                android:id="@+id/etBuscarOpcion"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="5dp"
                android:hint="buscar..."
                android:paddingHorizontal="5dp"
                android:paddingBottom="10dp"
                android:textColorHint="@color/grey_500"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/grey_900"
                android:layout_width="match_parent"
                android:drawableTint="@color/grey_900"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            tools:listitem="@layout/list_item_single_select_spinner"
            android:layout_height="wrap_content">

        </androidx.recyclerview.widget.RecyclerView>


    </LinearLayout>
    <LinearLayout
        android:id="@+id/fotterBtns"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:gravity="center"
        android:paddingEnd="10dp"
        android:paddingVertical="10dp"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/txt_cancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="Cancelar"
            android:backgroundTint="@color/grey_100"
            android:layout_gravity="center"
            android:textColor="@color/red_700"
            android:gravity="center"
            android:textSize="18sp"
            />


        <Button
            android:id="@+id/txt_aceptar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="ok"
            android:backgroundTint="@color/blue_100"
            android:textColor="@color/blue_900"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="18sp"/>

    </LinearLayout>
</RelativeLayout>
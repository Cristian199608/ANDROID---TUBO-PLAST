<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- CABECERA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTipoDocumento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOLETA"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#333333" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    >
                    <TextView
                        android:id="@+id/tvNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="B001-00001689"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/black" />
                </LinearLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="EMITIDA"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/green_800"
                android:background="@color/green_100" />

        </LinearLayout>

        <!-- SEPARADOR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E0E0E0" />

        <!-- FECHA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Fecha:"
                android:textColor="@color/grey_900"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-07-31"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView

                android:id="@+id/tvImporte"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="S/ 150.00"
                android:gravity="end"
                android:textColor="@color/grey_900"
                android:textStyle="bold"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- CLIENTE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Cliente:"
                android:textColor="@color/grey_900"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CUEVA CHUQUIZUTA TEODOCIA"
                android:textColor="#333333"
                android:textSize="14sp"
                android:maxLines="2" />

        </LinearLayout>

        <!-- RUC -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="RUC/DNI:"
                android:textColor="@color/grey_900"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRuc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="06063131"
                android:textColor="#333333"
                android:textSize="14sp" />

        </LinearLayout>
        <!-- BOTON API -->
        <Button
            android:id="@+id/btnProcesar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Descargar PDF"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>